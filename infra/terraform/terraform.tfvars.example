# CloudClearingAPI Terraform Configuration Example
# Copy this file to terraform.tfvars and customize

# ============================================================================
# General Configuration
# ============================================================================
project_name = "cloudclearing"
environment  = "dev"  # Change to "staging" or "prod" for other environments
aws_region   = "us-east-1"

# ============================================================================
# Network Configuration
# ============================================================================
vpc_cidr             = "10.0.0.0/16"
# RECOMMENDED for personal/portfolio dev: false — avoids NAT hourly charges; Terraform
# runs ECS tasks in public subnets with a public IP for GEE/scrapers/OSM.
# Use true for production-style private subnets + NAT.
enable_nat_gateway   = false
enable_vpc_endpoints = true   # Set false in dev to trim interface endpoint hourly cost
enable_flow_logs     = false  # Set to true for production (increases costs)

# ============================================================================
# Application Configuration
# ============================================================================
earthengine_project = "your-gee-project-id"  # REQUIRED: Your GEE Cloud Project ID
log_level           = "INFO"  # DEBUG, INFO, WARNING, ERROR

# ============================================================================
# ECS Configuration
# ============================================================================
# Task sizing based on workload:
# - Dev: 1024 CPU / 4096 MB (small regions, testing)
# - Staging: 2048 CPU / 8192 MB (full validation)
# - Prod: 4096 CPU / 16384 MB (29 regions, optimal performance)

ecs_task_cpu    = "2048"  # 2 vCPU
ecs_task_memory = "8192"  # 8 GB

# ============================================================================
# Pipeline email (Step Functions / SNS) — optional but needed for success/failure mail
# ============================================================================
pipeline_success_email = "your-email@example.com"
pipeline_failure_email = "your-email@example.com"

# ============================================================================
# Monitoring & Alerts (CloudWatch / budgets)
# ============================================================================
alarm_email_endpoints = [
  "your-email@example.com"
]

enable_cost_alerts   = true
monthly_budget_limit = "100"  # USD
enable_dashboard     = true

# ============================================================================
# Data Retention
# ============================================================================
logs_retention_days = 90  # Reduce to 30 for dev, keep 90+ for prod
