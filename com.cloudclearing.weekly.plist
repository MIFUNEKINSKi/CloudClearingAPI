<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cloudclearing.weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/chrismoore/Desktop/CloudClearingAPI/venv/bin/python</string>
        <string>/Users/chrismoore/Desktop/CloudClearingAPI/run_weekly_cron.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/chrismoore/Desktop/CloudClearingAPI</string>

    <!-- Run every Sunday at 9:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/chrismoore/Desktop/CloudClearingAPI/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/chrismoore/Desktop/CloudClearingAPI/logs/launchd_stderr.log</string>

    <!-- Don't run if laptop is on battery -->
    <key>LowPriorityIO</key>
    <true/>

    <!-- Run missed jobs when machine wakes up -->
    <key>StartInterval</key>
    <integer>604800</integer>
</dict>
</plist>
